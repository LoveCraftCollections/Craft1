# Public origin used for absolute Open Graph links in invitation previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase is scaffolded in supabase/migrations/ but is not connected to this demo app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only. Never prefix this variable with NEXT_PUBLIC_ or expose it to browsers.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key